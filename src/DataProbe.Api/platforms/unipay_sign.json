{
  "name": "unipay_sign",
  "description": "提取腾讯统一支付接口的 sign 字段（值是微信支付链接）",
  "priority": 100,
  "enabled": true,
  "scan_locations": [
    "response.body",
    "request.body"
  ],
  "matchers": [
    {"field": "domain", "operator": "contains", "value": "api.unipay.qq.com"},
    {"field": "path", "operator": "contains", "value": "/web_save"}
  ],
  "extractors": [
    {
      "name": "sign_payment_url",
      "source": "response_body",
      "output_field": "value",
      "data_type": "url",
      "pattern": "\"sign\"\\s*:\\s*\"(weixin://[^\"]+)\""
    },
    {
      "name": "sign_other",
      "source": "response_body",
      "output_field": "value",
      "data_type": "token",
      "pattern": "\"sign\"\\s*:\\s*\"([^\"]+)\""
    },
    {
      "name": "token_field",
      "source": "response_body",
      "output_field": "value",
      "data_type": "token",
      "pattern": "\"token\"\\s*:\\s*\"([^\"]+)\""
    },
    {
      "name": "out_trade_no",
      "source": "response_body",
      "output_field": "value",
      "data_type": "params",
      "pattern": "\"out_trade_no\"\\s*:\\s*\"([^\"]+)\""
    }
  ]
}
